{
  "name": "app",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "biome check",
    "lint-fix": "cd .. && bunx biome check --fix",
    "test": "bun test src/test",
    "test-unit": "bun test src/test/unit",
    "test-e2e": "bun test src/test/e2e --timeout 60000",
    "gen-types": "tsc --project tsconfig.types.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@elysiajs/cors": "1.4.0",
    "@elysiajs/static": "1.4.7",
    "@elysiajs/swagger": "1.3.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.0",
    "elysia": "1.4.18",
    "murmurhash": "^2.0.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "bun-types": "^1.3.8",
    "drizzle-kit": "^0.31.8",
    "typescript": "5.9.3"
  },
  "module": "src/index.js"
